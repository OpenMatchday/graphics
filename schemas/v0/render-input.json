{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render-input.json",
  "title": "Open Matchday graphics render input v0",
  "description": "Input to the deterministic SVG renderer. Token map is supplied by the caller (app/themes); graphics never ships theme packages.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graphics_version",
    "width",
    "height",
    "aspect",
    "resolution_label",
    "scene",
    "templates",
    "tokens"
  ],
  "properties": {
    "graphics_version": {
      "$ref": "common.json#/$defs/GraphicsVersion"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7680
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7680
    },
    "aspect": {
      "$ref": "common.json#/$defs/AspectRatio"
    },
    "resolution_label": {
      "$ref": "common.json#/$defs/ResolutionLabel"
    },
    "reduced_motion": {
      "type": "boolean",
      "default": true
    },
    "scene": {
      "$ref": "scene.json"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "template.json"
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^#[0-9A-Fa-f]{6}$|^[a-zA-Z][a-zA-Z0-9_-]*$"
      },
      "description": "Token id to CSS color or generic font-family keyword. Test harness supplies neutrals only."
    }
  }
}
