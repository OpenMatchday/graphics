{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template.json",
  "title": "Open Matchday graphics template v0",
  "description": "Declarative graphic template definition. Colors and fonts are token refs only (themes repo supplies values).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graphics_version",
    "template_id",
    "kind",
    "slots",
    "layout"
  ],
  "properties": {
    "graphics_version": {
      "$ref": "common.json#/$defs/GraphicsVersion"
    },
    "protocol_version": {
      "$ref": "common.json#/$defs/ProtocolVersionPin"
    },
    "template_id": {
      "$ref": "common.json#/$defs/Id"
    },
    "kind": {
      "$ref": "common.json#/$defs/TemplateKind"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "label"],
        "properties": {
          "slot_id": {
            "$ref": "common.json#/$defs/SlotId"
          },
          "label": {
            "$ref": "common.json#/$defs/NonEmptyString"
          },
          "max_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 512
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions"],
      "properties": {
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["region_id", "role", "x", "y", "w", "h"],
            "properties": {
              "region_id": {
                "$ref": "common.json#/$defs/Id"
              },
              "role": {
                "type": "string",
                "enum": ["panel", "text", "accent"]
              },
              "x": {
                "$ref": "common.json#/$defs/NormalizedNumber"
              },
              "y": {
                "$ref": "common.json#/$defs/NormalizedNumber"
              },
              "w": {
                "$ref": "common.json#/$defs/NormalizedNumber"
              },
              "h": {
                "$ref": "common.json#/$defs/NormalizedNumber"
              },
              "slot_id": {
                "$ref": "common.json#/$defs/SlotId"
              },
              "fill_token": {
                "$ref": "common.json#/$defs/TokenRef"
              },
              "text_token": {
                "$ref": "common.json#/$defs/TokenRef"
              },
              "font_size_ratio": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1,
                "description": "Font size as fraction of region height"
              }
            }
          }
        }
      }
    },
    "supports_motion": {
      "type": "boolean",
      "default": false
    }
  }
}
